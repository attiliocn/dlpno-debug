#!/usr/bin/env bash

# Pretend to be Singularity/ORCA and allocate enough memory to trigger the
# Slurm cgroup OOM killer. It intentionally ignores all command-line arguments.

set -euo pipefail

alloc_gb="${OOM_ALLOC_GB:-4}"

if ! command -v python3 >/dev/null 2>&1; then
    echo "fake-singularity: python3 not found" >&2
    exit 127
fi

echo "fake-singularity: allocating ${alloc_gb} GiB to trigger OOM" >&2

python3 - "$alloc_gb" <<'PY'
import sys

size_gb = int(sys.argv[1])
block = bytearray(size_gb * 1024**3)
print(f"allocated {len(block)} bytes")
PY
